# Copy this file to .env and adjust as needed. docker-compose reads .env
# automatically; it is NOT committed to git (see .gitignore).

# Left as-is, this matches the db/api services defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://sketchbook:sketchbook@db:5432/sketchbook

# Comma-separated list of origins allowed to call the API from a browser.
# Add the real address the frontend will be served from once you know it
# (e.g. a GitHub Pages URL), and drop the "*" wildcard.
CORS_ORIGINS=*
