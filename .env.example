# Copy this file to .env and adjust as needed. docker-compose reads .env
# automatically; it is NOT committed to git (see .gitignore).

# Left as-is, this matches the db/api services defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://sketchbook:sketchbook@db:5432/sketchbook

# Comma-separated list of origins allowed to call the API from a browser.
# Add the real address the frontend will be served from once you know it
# (e.g. a GitHub Pages URL), and drop the "*" wildcard.
CORS_ORIGINS=*

# Optional: only needed to test photo uploads (records' photo_url, the
# turntable's album art) locally. Leave unset and everything else still
# works fine — uploads alone will fail with a clear "upload failed" error
# instead of silently working.
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: only needed for "구글 계정으로 내 방 복구" (POST
# /api/auth/google). Not a secret — it's the OAuth client id from a
# Google Cloud Console project (APIs & Services > Credentials > OAuth
# client ID > Web application), with your frontend origin(s) — e.g.
# http://localhost:5500 and your GitHub Pages URL — added under
# "Authorized JavaScript origins". Must match the client_id the
# frontend uses (js/shared/config.js). Leave unset and the feature just
# fails with a clear "invalid google token" error instead of working.
GOOGLE_CLIENT_ID=

# Optional: only needed for the book search in the "새 기록" form (GET
# /api/search/book). A Kakao Developers app's "REST API 키"
# (developers.kakao.com > 내 애플리케이션). This one IS a secret — keep it
# here / in the server's env file only, never in the frontend. Leave unset
# and that endpoint answers 503 "book search unavailable"; the form then
# just works without search results.
KAKAO_REST_KEY=

# Optional: music search (GET /api/search/music) works without this. Path to
# a ytmusicapi browser-auth JSON for a THROWAWAY Google account, tried first
# in case signed-in searches return songs too; on any failure it falls back
# to the anonymous (albums only) search. Never use your main account.
YTMUSIC_AUTH_FILE=

# Optional: movie/anime search (GET /api/search/screen). TMDB's "API 읽기
# 액세스 토큰" (v4 bearer token) from themoviedb.org > 설정 > API — sent as a
# header, never in URLs. A secret: keep it here / in the server's env file
# only. Leave unset and that endpoint answers 503 "screen search unavailable".
TMDB_TOKEN=
